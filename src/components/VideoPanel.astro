---
import type { ImageValue } from "emdash";
import { Image } from "emdash/ui";
import ActionRail from "./ActionRail.astro";
import FeedCaption from "./FeedCaption.astro";
import { titleEchoesCaption } from "../utils/text";

/**
 * One full-viewport video panel in the swipe feed.
 *
 * The player is created by the feed script when the panel comes into view
 * and plays muted on its own; until it has painted a frame the poster stays
 * up. The media sits in a box of its own aspect ratio — handing the player
 * the whole column is wrong on a phone, where nothing in our code would
 * decide where the leftover height goes. Letterboxed rather than cropped:
 * these clips carry burned-in captions that run nearly the full width.
 */
interface Props {
	title: string;
	youtubeId?: string;
	/** Vimeo reference: "id" or "id:hash" for an unlisted video. */
	vimeoRef?: string | null;
	/** Self-hosted file (an Instagram import), used when there is no hosted id. */
	videoSrc?: string | null;
	featuredImage?: ImageValue | null;
	excerpt?: string | null;
	href: string;
	shareUrl: string;
	date?: string | null;
	index: number;
	contentId: string;
	ctaUrl?: string | null;
	ctaLabel?: string | null;
}

const {
	title,
	youtubeId,
	vimeoRef,
	videoSrc,
	featuredImage,
	excerpt,
	href,
	shareUrl,
	date,
	index,
	contentId,
	ctaUrl,
	ctaLabel,
} = Astro.props;

// The poster is a frame of the video, so its shape is the video's shape.
const ratio =
	featuredImage?.width && featuredImage?.height
		? featuredImage.width / featuredImage.height
		: 16 / 9;
const showTitle = !titleEchoesCaption(title, excerpt);
---

<section class="panel" data-panel aria-label={title}>
	<div class="media">
		<div
			class="box"
			style={`--arn:${ratio.toFixed(4)}`}
			data-player
			data-video-id={youtubeId || undefined}
			data-vimeo={vimeoRef || undefined}
			data-video-src={videoSrc || undefined}
			data-title={title}
		>
			{
				featuredImage ? (
					<Image
						image={featuredImage}
						class="poster"
						loading={index < 2 ? "eager" : "lazy"}
					/>
				) : (
					<span class="poster poster-empty" />
				)
			}
			<button type="button" class="play-glyph" data-play hidden>
				<span class="visually-hidden">Play {title}</span>
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M8 5.5v13l11-6.5z"></path>
				</svg>
			</button>
			<div class="ring" data-ring hidden>
				<span class="visually-hidden">Loading</span>
			</div>
		</div>
		<ActionRail video collection="posts" contentId={contentId} shareUrl={shareUrl} shareTitle={title} />
		{
			index === 0 && (
				<p class="swipe-hint" data-swipe-hint>
					Swipe up for more ↑
				</p>
			)
		}
	</div>

	<div class="text">
		<FeedCaption
			kicker={date}
			title={title}
			href={href}
			caption={excerpt}
			showTitle={showTitle}
			ctaUrl={ctaUrl}
			ctaLabel={ctaLabel}
		/>
	</div>
</section>

<style>
	.panel {
		height: 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		padding-top: env(safe-area-inset-top, 0px);
		box-sizing: border-box;
	}

	.media {
		position: relative;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8px 0;
		/* Lets the box size itself from this area's height (100cqh). */
		container-type: size;
	}

	/* Width is the one definite dimension; the ratio derives the height. */
	.box {
		position: relative;
		width: min(100%, calc(100cqh * var(--arn)));
		aspect-ratio: var(--arn);
		background: #000;
		border-radius: 12px;
		overflow: hidden;
	}

	.box:fullscreen,
	.box:-webkit-full-screen {
		width: 100%;
		height: 100%;
		aspect-ratio: auto;
		border-radius: 0;
	}

	.box :global(.poster),
	.box :global(video),
	.box :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		object-fit: contain;
		background: #000;
	}

	.box :global(.poster) {
		z-index: 1;
		transition: opacity 180ms ease-out;
	}

	.poster-empty {
		background: #17171a;
	}

	/* Fed by the player's first painted frame, never by "play" — that fires
	   before a frame exists. And not by "paused": a paused video still has a
	   picture on screen. */
	.box.is-painted :global(.poster) {
		opacity: 0;
		pointer-events: none;
	}

	.play-glyph {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		width: 64px;
		height: 64px;
		margin: -32px 0 0 -32px;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: 50%;
		color: #111;
		background: rgb(255 255 255 / 0.94);
		box-shadow: 0 4px 16px rgb(0 0 0 / 0.4);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.play-glyph[hidden] {
		display: none;
	}

	.play-glyph svg {
		width: 32px;
		height: 32px;
		margin-left: 3px;
	}

	/* The ring is decorative; the label carries the meaning, so it still
	   reads with motion switched off. */
	.ring {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		width: 56px;
		height: 56px;
		margin: -28px 0 0 -28px;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.45);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.ring[hidden] {
		display: none;
	}

	.ring::after {
		content: "";
		position: absolute;
		inset: 13px;
		border-radius: 50%;
		border: 3px solid rgb(255 255 255 / 0.28);
		border-top-color: #fff;
		animation: spin 900ms linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.swipe-hint {
		position: absolute;
		top: 16px;
		left: 50%;
		z-index: 3;
		transform: translateX(-50%);
		margin: 0;
		padding: 7px 14px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.16);
		color: #fff;
		font-size: 0.8125rem;
		white-space: nowrap;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition: opacity 300ms;
	}

	.swipe-hint.is-gone {
		opacity: 0;
		pointer-events: none;
	}

	.text {
		padding: 12px var(--spacing-5) calc(env(safe-area-inset-bottom, 0px) + 96px);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.ring::after {
			animation: none;
		}

		.box :global(.poster),
		.swipe-hint {
			transition: none;
		}
	}
</style>
