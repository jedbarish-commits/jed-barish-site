---
import { Image } from "emdash/ui";

/**
 * One full-viewport photo panel in the swipe feed, sized to sit alongside
 * VideoPanel. Photos have no fixed aspect ratio the way a 16:9 embed does, so
 * the image is capped by height and centred rather than cropped — a portrait
 * shot shouldn't be chopped to a landscape box.
 */
interface Props {
	title: string;
	image: unknown;
	caption?: string | null;
	location?: string | null;
	date?: string | null;
	index: number;
}

const { title, image, caption, location, date, index } = Astro.props;
---

<section class="panel" aria-label={title}>
	<div class="panel-inner">
		<div class="frame">
			<Image image={image} loading={index < 2 ? "eager" : "lazy"} />
		</div>

		<div class="meta">
			<h2 class="title">{title}</h2>
			{caption && <p class="caption">{caption}</p>}
			<p class="sub">
				{location && <span class="location">{location}</span>}
				{location && date && <span class="dot" aria-hidden="true"></span>}
				{date && <span>{date}</span>}
			</p>
		</div>
	</div>
</section>

<style>
	.panel {
		height: 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 104px;
		box-sizing: border-box;
	}

	.panel-inner {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
		min-height: 0;
	}

	.frame {
		border-radius: 14px;
		overflow: hidden;
		background: #000;
		box-shadow: 0 8px 28px -10px rgb(0 0 0 / 0.7);
		display: flex;
		justify-content: center;
		min-height: 0;
	}

	.frame :global(img) {
		max-width: 100%;
		max-height: 62dvh;
		width: auto;
		height: auto;
		object-fit: contain;
		display: block;
	}

	.meta {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.title {
		font-size: 1.25rem;
		line-height: 1.25;
		font-weight: 600;
		letter-spacing: var(--tracking-tight);
		margin: 0;
		color: #fff;
	}

	.caption {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: rgb(255 255 255 / 0.66);
	}

	.sub {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.4);
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
	}
</style>
