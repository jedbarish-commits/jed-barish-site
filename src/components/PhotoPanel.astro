---
import type { ImageValue } from "emdash";
import { Image } from "emdash/ui";
import ActionRail from "./ActionRail.astro";
import FeedCaption from "./FeedCaption.astro";
import { titleEchoesCaption } from "../utils/text";

/**
 * One full-viewport photo panel in the swipe feed, laid out exactly like
 * VideoPanel so the two read as one feed. The box takes the photo's own
 * aspect ratio — a portrait shot isn't chopped to a landscape frame.
 */
interface Props {
	title: string;
	image: ImageValue | null | undefined;
	caption?: string | null;
	location?: string | null;
	date?: string | null;
	shareUrl: string;
	index: number;
	contentId: string;
}

const { title, image, caption, location, date, shareUrl, index, contentId } = Astro.props;

const ratio = image?.width && image?.height ? image.width / image.height : 1;
// The title is usually just the caption's first line, clipped; show the
// caption's full text instead of both.
const showTitle = !titleEchoesCaption(title, caption);
const kicker = [location, date].filter(Boolean).join(" · ");
---

<section class="panel" data-panel aria-label={title}>
	<div class="media">
		<div class="box" style={`--arn:${ratio.toFixed(4)}`}>
			<Image image={image} class="photo" loading={index < 2 ? "eager" : "lazy"} />
		</div>
		<ActionRail collection="photos" contentId={contentId} shareUrl={shareUrl} shareTitle={title} />
		{
			index === 0 && (
				<p class="swipe-hint" data-swipe-hint>
					Swipe up for more ↑
				</p>
			)
		}
	</div>

	<div class="text">
		<FeedCaption kicker={kicker || null} title={title} caption={caption} showTitle={showTitle} />
	</div>
</section>

<style>
	.panel {
		height: 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		padding-top: env(safe-area-inset-top, 0px);
		box-sizing: border-box;
	}

	.media {
		position: relative;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8px 0;
		container-type: size;
	}

	.box {
		position: relative;
		width: min(100%, calc(100cqh * var(--arn)));
		aspect-ratio: var(--arn);
		background: #000;
		border-radius: 12px;
		overflow: hidden;
	}

	.box :global(.photo) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.swipe-hint {
		position: absolute;
		top: 16px;
		left: 50%;
		z-index: 3;
		transform: translateX(-50%);
		margin: 0;
		padding: 7px 14px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.16);
		color: #fff;
		font-size: 0.8125rem;
		white-space: nowrap;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition: opacity 300ms;
	}

	.swipe-hint.is-gone {
		opacity: 0;
		pointer-events: none;
	}

	.text {
		padding: 12px var(--spacing-5) calc(env(safe-area-inset-bottom, 0px) + 96px);
	}

	@media (prefers-reduced-motion: reduce) {
		.swipe-hint {
			transition: none;
		}
	}
</style>
