---
/**
 * Floating bottom navigation — the app-shell nav bar.
 * Sits above the safe-area inset so it clears the iPhone home indicator.
 */
interface NavItem {
	label: string;
	href: string;
	icon: "feed" | "grid" | "search" | "link";
}

interface Props {
	items: NavItem[];
	current?: string;
}

const { items, current = "/" } = Astro.props;

function isActive(href: string) {
	if (href === "/") return current === "/";
	return current === href || current.startsWith(`${href}/`);
}
---

<nav class="bottom-nav" aria-label="Primary">
	<ul class="nav-pill">
		{
			items.map((item) => (
				<li>
					<a
						href={item.href}
						class:list={["nav-item", { active: isActive(item.href) }]}
						aria-current={isActive(item.href) ? "page" : undefined}
					>
						<span class="nav-icon" aria-hidden="true">
							{item.icon === "feed" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="3" width="18" height="18" rx="4" />
									<path d="m10 8.5 5.5 3.5-5.5 3.5z" fill="currentColor" stroke="none" />
								</svg>
							)}
							{item.icon === "grid" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="3" width="7.5" height="7.5" rx="2" />
									<rect x="13.5" y="3" width="7.5" height="7.5" rx="2" />
									<rect x="3" y="13.5" width="7.5" height="7.5" rx="2" />
									<rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2" />
								</svg>
							)}
							{item.icon === "search" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="11" cy="11" r="7" />
									<path d="m16.5 16.5 4 4" />
								</svg>
							)}
							{item.icon === "link" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="8.5" />
								</svg>
							)}
						</span>
						<span class="nav-label">{item.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.bottom-nav {
		position: fixed;
		left: 50%;
		transform: translateX(-50%);
		bottom: calc(var(--nav-gap) + env(safe-area-inset-bottom, 0px));
		z-index: 50;
		width: min(100% - var(--spacing-8), var(--app-width));
		display: flex;
		justify-content: center;
		pointer-events: none;
	}

	.nav-pill {
		pointer-events: auto;
		display: flex;
		align-items: stretch;
		gap: var(--spacing-1);
		padding: 6px;
		margin: 0;
		list-style: none;
		border-radius: 999px;
		background: var(--nav-bg);
		border: 1px solid var(--nav-border);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.28),
			0 12px 32px -8px rgb(0 0 0 / 0.45);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
	}

	.nav-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 3px;
		min-width: 68px;
		min-height: 48px;
		padding: var(--spacing-2) var(--spacing-3);
		border-radius: 999px;
		text-decoration: none;
		color: var(--nav-fg-muted);
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
		-webkit-tap-highlight-color: transparent;
	}

	.nav-item.active {
		color: var(--nav-fg-active);
		background: var(--nav-active-bg);
	}

	.nav-icon {
		display: block;
		width: 21px;
		height: 21px;
	}

	.nav-icon svg {
		width: 100%;
		height: 100%;
		display: block;
	}

	.nav-label {
		font-size: 10px;
		font-weight: 500;
		letter-spacing: var(--tracking-wide);
	}

	/* Pointer devices get a hover affordance; touch devices skip it so the
	   style doesn't stick after a tap. */
	@media (hover: hover) {
		.nav-item:hover {
			color: var(--nav-fg-active);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-item {
			transition: none;
		}
	}
</style>
