---
export const prerender = false;

import { search } from "emdash";
import MobileShell from "../layouts/MobileShell.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// FTS-backed search rather than loading every post and filtering in JS.
const { items: results } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };
---

<MobileShell
	title={query ? `Search: ${query}` : "Search"}
	description="Search videos"
>
	<section class="search-page">
		<h1>Search</h1>

		<form method="get" action="/search" class="form">
			<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m16.5 16.5 4 4"></path>
			</svg>
			<input
				type="search"
				name="q"
				value={query}
				placeholder="Search videos…"
				enterkeyhint="search"
				autocomplete="off"
			/>
		</form>

		{
			query && (
				<p class="summary">
					{results.length === 0
						? `No results for “${query}”`
						: `${results.length} result${results.length === 1 ? "" : "s"}`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="results">
					{results.map((result) => (
						<li>
							<a href={`/videos/${result.slug ?? result.id}`}>
								<span class="result-title">{result.title ?? "Untitled"}</span>
								{result.snippet && (
									<span class="result-snippet" set:html={result.snippet} />
								)}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="hint">Search across every video on the site.</p>}
	</section>
</MobileShell>

<style>
	.search-page {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	h1 {
		margin: 0 0 var(--spacing-4);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}

	.form {
		position: relative;
		display: flex;
		align-items: center;
	}

	.icon {
		position: absolute;
		left: 13px;
		width: 17px;
		height: 17px;
		color: rgb(255 255 255 / 0.4);
		pointer-events: none;
	}

	input {
		width: 100%;
		padding: 12px 16px 12px 38px;
		font: inherit;
		font-size: 16px; /* keeps iOS from zooming the viewport on focus */
		color: #fff;
		background: rgb(255 255 255 / 0.07);
		border: 1px solid rgb(255 255 255 / 0.12);
		border-radius: 12px;
		-webkit-appearance: none;
		appearance: none;
	}

	input::placeholder {
		color: rgb(255 255 255 / 0.38);
	}

	input:focus {
		outline: none;
		border-color: rgb(255 255 255 / 0.3);
		background: rgb(255 255 255 / 0.1);
	}

	.summary,
	.hint {
		margin: var(--spacing-4) 0 0;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.45);
	}

	.results {
		list-style: none;
		margin: var(--spacing-5) 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.results a {
		display: block;
		padding: var(--spacing-4) 0;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
		text-decoration: none;
		color: inherit;
	}

	.result-title {
		display: block;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.result-snippet {
		display: block;
		margin-top: 4px;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: rgb(255 255 255 / 0.55);
	}

	.result-snippet :global(mark) {
		background: none;
		color: #fff;
		font-weight: 600;
	}
</style>
