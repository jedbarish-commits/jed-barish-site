---
export const prerender = false;

import type { ImageValue } from "emdash";
import { getEmDashEntry, search } from "emdash";
import { Image } from "emdash/ui";
import MobileShell from "../layouts/MobileShell.astro";
import { titleEchoesCaption } from "../utils/text";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// FTS-backed search across both collections rather than loading everything
// and filtering in JS. Videos index title, body and transcript; photos index
// title, caption and location.
const { items: hits } = query
	? await search(query, { collections: ["posts", "photos"], limit: 30 })
	: { items: [] };

// Search hits carry no images, so each entry is fetched for its thumbnail.
const results = await Promise.all(
	hits.map(async (hit) => {
		const key = hit.slug ?? hit.id;
		const isPhoto = hit.collection === "photos";
		const { entry } = isPhoto
			? await getEmDashEntry("photos", key)
			: await getEmDashEntry("posts", key);
		const data = (entry?.data ?? {}) as Record<string, unknown>;
		const image = (isPhoto ? data.image : data.featured_image) as ImageValue | undefined;

		// Imported items have a title that is just the caption's first line; when
		// the snippet already opens with it, the snippet alone says everything.
		const snippetText = (hit.snippet ?? "").replace(/<[^>]+>/g, "");
		const echo = !!hit.snippet && titleEchoesCaption(hit.title, snippetText);

		return {
			...hit,
			href: isPhoto ? `/photos?p=${key}` : `/videos/${key}`,
			kind: isPhoto ? "Photo" : "Video",
			image,
			echo,
		};
	}),
);
---

<MobileShell
	title={query ? `Search: ${query}` : "Search"}
	description="Search videos and photos"
>
	<section class="search-page">
		<h1>Search</h1>

		<form method="get" action="/search" class="form">
			<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m16.5 16.5 4 4"></path>
			</svg>
			<input
				type="search"
				name="q"
				value={query}
				placeholder="Search videos and photos…"
				enterkeyhint="search"
				autocomplete="off"
			/>
		</form>

		{
			query && (
				<p class="summary">
					{results.length === 0
						? `No results for “${query}”`
						: `${results.length} result${results.length === 1 ? "" : "s"}`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="results">
					{results.map((r) => (
						<li>
							<a href={r.href} class="result">
								<span class="thumb">
									{r.image ? <Image image={r.image} loading="lazy" /> : <span class="thumb-empty" />}
								</span>
								<span class="body">
									<span class="kind">{r.kind}</span>
									{!r.echo && <span class="result-title">{r.title ?? "Untitled"}</span>}
									{r.snippet ? (
										<span class:list={["result-snippet", { lead: r.echo }]} set:html={r.snippet} />
									) : (
										r.echo && <span class="result-title">{r.title}</span>
									)}
								</span>
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="hint">Search across every video and photo on the site.</p>}
	</section>
</MobileShell>

<style>
	.search-page {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	h1 {
		margin: 0 0 var(--spacing-4);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}

	.form {
		position: relative;
		display: flex;
		align-items: center;
	}

	.icon {
		position: absolute;
		left: 13px;
		width: 17px;
		height: 17px;
		color: rgb(255 255 255 / 0.4);
		pointer-events: none;
	}

	input {
		width: 100%;
		padding: 12px 16px 12px 38px;
		font: inherit;
		font-size: 16px; /* keeps iOS from zooming the viewport on focus */
		color: #fff;
		background: rgb(255 255 255 / 0.07);
		border: 1px solid rgb(255 255 255 / 0.12);
		border-radius: 12px;
		-webkit-appearance: none;
		appearance: none;
	}

	input::placeholder {
		color: rgb(255 255 255 / 0.38);
	}

	input:focus {
		outline: none;
		border-color: rgb(255 255 255 / 0.3);
		background: rgb(255 255 255 / 0.1);
	}

	.summary,
	.hint {
		margin: var(--spacing-4) 0 0;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.45);
	}

	.results {
		list-style: none;
		margin: var(--spacing-5) 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.result {
		display: grid;
		grid-template-columns: 88px 1fr;
		gap: var(--spacing-3);
		align-items: center;
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
		text-decoration: none;
		color: inherit;
	}

	.thumb {
		display: block;
		aspect-ratio: 1;
		border-radius: 10px;
		overflow: hidden;
		background: #17171a;
	}

	.thumb :global(img),
	.thumb-empty {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}

	.kind {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.4);
	}

	.result-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.result-snippet {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: rgb(255 255 255 / 0.55);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Standing in for the title, so it carries the weight instead. */
	.result-snippet.lead {
		font-size: 0.9375rem;
		color: rgb(255 255 255 / 0.9);
	}

	.result-snippet :global(mark) {
		background: none;
		color: #fff;
		font-weight: 700;
	}
</style>
