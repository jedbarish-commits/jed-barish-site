---
import { getEmDashCollection, getSiteSettings } from "emdash";
import MobileShell from "../layouts/MobileShell.astro";
import VideoPanel from "../components/VideoPanel.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 50,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function formatDate(date: Date | null | undefined) {
	if (!date) return null;
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<MobileShell title={siteTitle} description={siteTagline} fullBleed>
	{
		posts.length === 0 ? (
			<div class="empty">
				<h1>Nothing here yet</h1>
				<p>Publish a post and it shows up in the feed.</p>
				<a href="/_emdash/admin/content/posts" class="empty-btn">
					Open admin
				</a>
			</div>
		) : (
			<div class="feed" data-feed>
				{posts.map((post, i) => (
					<VideoPanel
						title={post.data.title ?? "Untitled"}
						youtubeId={post.data.youtube_id ?? ""}
						featuredImage={post.data.featured_image}
						excerpt={post.data.excerpt}
						href={`/posts/${post.id}`}
						date={formatDate(post.data.publishedAt)}
						index={i}
					/>
				))}
			</div>
		)
	}
</MobileShell>

<style>
	.feed {
		height: 100%;
		overflow-y: auto;
		scroll-snap-type: y mandatory;
		/* Stops the swipe from chaining into Safari's pull-to-refresh. */
		overscroll-behavior-y: contain;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.feed::-webkit-scrollbar {
		display: none;
	}

	.empty {
		height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-3);
		padding: var(--spacing-6);
		text-align: center;
	}

	.empty h1 {
		font-size: 1.375rem;
		font-weight: 600;
		margin: 0;
	}

	.empty p {
		margin: 0;
		color: rgb(255 255 255 / 0.6);
		font-size: 0.9375rem;
	}

	.empty-btn {
		margin-top: var(--spacing-3);
		padding: 10px 20px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.12);
		border: 1px solid rgb(255 255 255 / 0.16);
		color: #fff;
		text-decoration: none;
		font-size: 0.875rem;
	}
</style>

<script>
	// Facade player: the YouTube iframe is only created on tap, and torn back
	// down once its panel scrolls out of view so audio never trails behind the
	// visible video.
	const feed = document.querySelector<HTMLElement>("[data-feed]");

	if (feed) {
		const teardown = new Map<Element, () => void>();

		function activate(player: HTMLElement) {
			const videoId = player.dataset.videoId;
			if (!videoId || player.querySelector("iframe")) return;

			const trigger = player.querySelector<HTMLElement>("[data-play]");
			const params = new URLSearchParams({
				autoplay: "1",
				playsinline: "1",
				rel: "0",
				modestbranding: "1",
				// Captions on by default.
				cc_load_policy: "1",
			});

			const iframe = document.createElement("iframe");
			iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
			iframe.title = player.dataset.title ?? "Video";
			iframe.allow =
				"accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share";
			iframe.allowFullscreen = true;

			trigger?.remove();
			player.appendChild(iframe);

			teardown.set(player, () => {
				iframe.remove();
				if (trigger) player.appendChild(trigger);
				teardown.delete(player);
			});
		}

		feed.addEventListener("click", (event) => {
			const trigger = (event.target as HTMLElement).closest("[data-play]");
			if (!trigger) return;
			const player = trigger.closest<HTMLElement>("[data-player]");
			if (player) activate(player);
		});

		// Unload a player once its panel is mostly off-screen.
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) continue;
					teardown.get(entry.target)?.();
				}
			},
			{ root: feed, threshold: 0.4 },
		);

		for (const player of feed.querySelectorAll("[data-player]")) {
			observer.observe(player);
		}
	}
</script>
