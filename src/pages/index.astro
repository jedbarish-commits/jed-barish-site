---
import { getEmDashCollection, getSiteSettings } from "emdash";
import MobileShell from "../layouts/MobileShell.astro";
import VideoPanel from "../components/VideoPanel.astro";
import PhotoPanel from "../components/PhotoPanel.astro";
import CaptionSheet from "../components/CaptionSheet.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// The feed is everything, newest first — videos and photos interleaved. They
// live in separate collections so each can be managed on its own, and are
// merged here rather than in the CMS.
const [videos, photos, settings] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 60 }),
	getEmDashCollection("photos", { orderBy: { published_at: "desc" }, limit: 60 }),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
	Astro.cache.set(videos.cacheHint);
	Astro.cache.set(photos.cacheHint);
}

type FeedItem =
	| { kind: "video"; at: number; entry: (typeof videos.entries)[number] }
	| { kind: "photo"; at: number; entry: (typeof photos.entries)[number] };

// A photo's real date is when it was taken, which for an imported back
// catalogue is years before it was published here. Sort on that, falling back
// to publish time for anything without it.
const when = (entry: {
	data: { taken_at?: Date | string | null; publishedAt?: Date | null };
}) => {
	const value = entry.data.taken_at ?? entry.data.publishedAt;
	return value ? new Date(value).getTime() : 0;
};

const feed: FeedItem[] = [
	...videos.entries.map((entry) => ({ kind: "video" as const, at: when(entry), entry })),
	...photos.entries.map((entry) => ({ kind: "photo" as const, at: when(entry), entry })),
].sort((a, b) => b.at - a.at);

// Video is served by our own endpoint, not EmDash's media route: that route
// answers a byte-range request with a full-body 200, which breaks seeking and
// stops iOS Safari playing at all.
const fileSrc = (value: unknown): string | null => {
	if (!value || typeof value !== "object") return null;
	const f = value as Record<string, unknown>;
	if (typeof f.src === "string" && f.src) return f.src;
	const meta = f.meta as Record<string, unknown> | undefined;
	const key =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof f.id === "string" ? f.id : undefined);
	return key ? `/api/video/${key}` : null;
};

const formatDate = (value: Date | string | null | undefined) =>
	value
		? new Date(value).toLocaleDateString("en-US", {
				year: "numeric",
				month: "short",
				day: "numeric",
			})
		: null;
---

<MobileShell title={siteTitle} description={siteTagline} fullBleed>
	{
		feed.length === 0 ? (
			<div class="empty">
				<h1>Nothing here yet</h1>
				<p>Publish a video or a photo and it shows up in the feed.</p>
				<a href="/_emdash/admin" class="empty-btn">
					Open admin
				</a>
			</div>
		) : (
			<div class="feed" data-feed>
				{feed.map((item, i) =>
					item.kind === "video" ? (
						<VideoPanel
							title={item.entry.data.title ?? "Untitled"}
							youtubeId={item.entry.data.youtube_id ?? ""}
							vimeoRef={item.entry.data.vimeo_id}
							videoSrc={fileSrc(item.entry.data.video_file)}
							ctaUrl={item.entry.data.cta_url}
							ctaLabel={item.entry.data.cta_label}
							featuredImage={item.entry.data.featured_image}
							excerpt={item.entry.data.excerpt}
							href={`/videos/${item.entry.id}`}
							shareUrl={`${Astro.url.origin}/videos/${item.entry.id}`}
							date={formatDate(item.entry.data.publishedAt)}
							contentId={item.entry.data.id}
							index={i}
						/>
					) : (
						<PhotoPanel
							title={item.entry.data.title ?? "Untitled"}
							image={item.entry.data.image}
							caption={item.entry.data.caption}
							location={item.entry.data.location}
							date={formatDate(
								item.entry.data.taken_at ?? item.entry.data.publishedAt,
							)}
							shareUrl={`${Astro.url.origin}/photos?p=${item.entry.id}`}
							contentId={item.entry.data.id}
							index={i}
						/>
					),
				)}
			</div>
		)
	}
	<CaptionSheet />
</MobileShell>

<style>
	.feed {
		height: 100%;
		overflow-y: auto;
		scroll-snap-type: y mandatory;
		/* Stops the swipe from chaining into Safari's pull-to-refresh. */
		overscroll-behavior-y: contain;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.feed::-webkit-scrollbar {
		display: none;
	}

	.empty {
		height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-3);
		padding: var(--spacing-6);
		text-align: center;
	}

	.empty h1 {
		font-size: 1.375rem;
		font-weight: 600;
		margin: 0;
	}

	.empty p {
		margin: 0;
		color: rgb(255 255 255 / 0.6);
		font-size: 0.9375rem;
	}

	.empty-btn {
		margin-top: var(--spacing-3);
		padding: 10px 20px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.12);
		border: 1px solid rgb(255 255 255 / 0.16);
		color: #fff;
		text-decoration: none;
		font-size: 0.875rem;
	}
</style>

<script>
	import { bindSnapKeys } from "../utils/snap-keys";
	import { mountFeed } from "../utils/feed-player";

	const feed = document.querySelector<HTMLElement>("[data-feed]");
	if (feed) {
		mountFeed(feed);
		bindSnapKeys(feed, ".panel");
	}
</script>
