---
import { getTaxonomyTerms } from "emdash";
import MobileShell from "../layouts/MobileShell.astro";

/**
 * Studio — posting from a phone without opening the CMS admin.
 *
 * Paste a YouTube or Vimeo link (or pick a file), and a video or photo is
 * live in about fifteen seconds. It runs as the signed-in EmDash user: the
 * page is only rendered for a session, and every write goes straight from the
 * browser to EmDash's own API with that session, so EmDash's permission
 * checks apply and signing out ends access. No second credential exists.
 */

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect("/_emdash/admin/login?redirect=/studio");
}

// Flatten the category tree — the picker is a row of chips, not an outline.
type Term = { slug: string; label: string; children?: Term[] };
const flatten = (terms: Term[], depth = 0): { slug: string; label: string }[] =>
	terms.flatMap((t) => [
		{ slug: t.slug, label: depth ? `${"· ".repeat(depth)}${t.label}` : t.label },
		...flatten(t.children ?? [], depth + 1),
	]);

const [categoryTerms, tagTerms] = await Promise.all([
	getTaxonomyTerms("category"),
	getTaxonomyTerms("tag"),
]);
const categories = flatten(categoryTerms as unknown as Term[]);
const tags = (tagTerms as unknown as Term[]).map((t) => ({ slug: t.slug, label: t.label }));

const displayName = user.name || user.email;
---

<MobileShell title="Studio" robots="noindex, nofollow" adminEscape={false}>
	<div class="studio" data-studio data-tags={JSON.stringify(tags)}>
		<header class="head">
			<h1>Studio</h1>
			<p class="who">
				<a href="/_emdash/admin">{displayName}</a>
				<span aria-hidden="true">·</span>
				<button type="button" class="linkish" data-signout>Sign out</button>
			</p>
		</header>

		<div class="seg" role="tablist" aria-label="What to post">
			<button type="button" role="tab" aria-selected="true" data-mode="video">Video</button>
			<button type="button" role="tab" aria-selected="false" data-mode="photo">Photo</button>
		</div>

		<form class="composer" data-form novalidate>
			<!-- Video source -->
			<section data-pane="video">
				<label class="field">
					<span class="label">YouTube or Vimeo link</span>
					<input
						type="url"
						name="link"
						inputmode="url"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
						placeholder="https://youtu.be/… or https://vimeo.com/…"
						data-link
					/>
				</label>
				<p class="status" data-link-status aria-live="polite"></p>

				<div class="or"><span>or</span></div>

				<label class="field">
					<span class="label">Upload a video file</span>
					<input type="file" name="videoFile" accept="video/mp4,video/quicktime,video/webm" data-video-file />
					<span class="hint">MP4 up to 50 MB. A frame from the file becomes the thumbnail.</span>
				</label>
			</section>

			<!-- Photo source -->
			<section data-pane="photo" hidden>
				<label class="field">
					<span class="label">Photo</span>
					<input type="file" name="photoFile" accept="image/*" data-photo-file />
					<span class="hint">Anything from the camera roll. Large photos are resized before upload.</span>
				</label>

				<div class="or"><span>or</span></div>

				<label class="field">
					<span class="label">Image URL</span>
					<input
						type="url"
						name="photoUrl"
						inputmode="url"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
						placeholder="https://…/photo.jpg"
						data-photo-url
					/>
				</label>
			</section>

			<div class="preview" data-preview hidden>
				<img alt="" data-preview-img />
				<video muted playsinline data-preview-video hidden></video>
			</div>

			<label class="field">
				<span class="label">Title</span>
				<input type="text" name="title" autocomplete="off" data-title required />
			</label>

			<label class="field">
				<span class="label">Caption</span>
				<textarea name="caption" rows="4" data-caption></textarea>
			</label>

			<!-- Photo-only details -->
			<div data-pane="photo" hidden>
				<label class="field">
					<span class="label">Location</span>
					<input type="text" name="location" autocomplete="off" data-location />
				</label>
				<label class="field">
					<span class="label">Date taken</span>
					<input type="date" name="takenAt" data-taken-at />
				</label>
			</div>

			<!-- Video-only details -->
			<div data-pane="video">
				{
					categories.length > 0 && (
						<fieldset class="field chips-field">
							<legend class="label">Category</legend>
							<div class="chips" data-categories>
								{categories.map((c) => (
									<button type="button" class="chip" data-slug={c.slug} aria-pressed="false">
										{c.label}
									</button>
								))}
								<button type="button" class="chip chip-add" data-add-category>+ New</button>
							</div>
						</fieldset>
					)
				}
				{
					categories.length === 0 && (
						<fieldset class="field chips-field">
							<legend class="label">Category</legend>
							<div class="chips" data-categories>
								<button type="button" class="chip chip-add" data-add-category>+ New category</button>
							</div>
						</fieldset>
					)
				}

				<button type="button" class="linkish more-toggle" data-more-toggle aria-expanded="false">
					More details
				</button>

				<div class="more" data-more hidden>
					<div class="field">
						<span class="label" id="tags-label">Tags</span>
						<div class="tags" data-tags-box>
							<input
								type="text"
								autocomplete="off"
								autocapitalize="off"
								placeholder="Type a tag, press Enter"
								aria-labelledby="tags-label"
								list="known-tags"
								data-tag-input
							/>
						</div>
						<datalist id="known-tags">
							{tags.map((t) => <option value={t.label} />)}
						</datalist>
						<span class="hint">Tags connect videos to each other. Picking an existing one beats a near-match.</span>
					</div>

					<label class="field">
						<span class="label">Link (optional)</span>
						<input type="url" name="ctaUrl" inputmode="url" autocapitalize="off" placeholder="https://…" data-cta-url />
						<span class="hint">Shows as a button on the video — a sponsor, an event, the full-length cut.</span>
					</label>

					<label class="field">
						<span class="label">Button label</span>
						<input type="text" name="ctaLabel" placeholder="Learn more" maxlength="40" data-cta-label />
					</label>

					<label class="field">
						<span class="label">Transcript / captions</span>
						<textarea name="transcript" rows="6" data-transcript></textarea>
						<span class="hint">Searchable on the site, so this is worth filling in.</span>
					</label>
				</div>
			</div>

			<div class="actions">
				<button type="submit" class="btn primary" data-publish>Publish</button>
				<button type="button" class="btn" data-draft>Draft</button>
			</div>
			<p class="foot" data-foot aria-live="polite"></p>
			<div class="progress" data-progress hidden><i></i></div>
		</form>

		<div class="done" data-done hidden>
			<h2 data-done-title>Published</h2>
			<p data-done-text></p>
			<div class="actions">
				<a class="btn primary" data-done-link href="/">View</a>
				<button type="button" class="btn" data-again>Post another</button>
			</div>
		</div>
	</div>
</MobileShell>

<style>
	.studio {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-5)) var(--spacing-5) 130px;
	}

	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-5);
	}

	.head h1 {
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	.who {
		display: flex;
		gap: 6px;
		margin: 0;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.55);
	}

