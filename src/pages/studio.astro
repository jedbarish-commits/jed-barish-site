		border: 0;
		border-radius: 999px;
		background: none;
		color: rgb(255 255 255 / 0.6);
		font: inherit;
		font-size: 0.9375rem;
		font-weight: 500;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.seg button[aria-selected="true"] {
		background: rgb(255 255 255 / 0.14);
		color: #fff;
	}

	/* Several containers below set display:flex, which would beat the UA's
	   [hidden] rule and un-hide the inactive pane. */
	.studio [hidden] {
		display: none !important;
	}

	.composer {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.composer section,
	.composer [data-pane] {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		border: 0;
		padding: 0;
		margin: 0;
	}

	.label {
		font-size: 0.9375rem;
		font-weight: 500;
		color: rgb(255 255 255 / 0.9);
	}

	.hint {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: rgb(255 255 255 / 0.5);
	}

	input[type="text"],
	input[type="url"],
	input[type="date"],
	textarea {
		width: 100%;
		padding: 14px 16px;
		border-radius: 14px;
		border: 1px solid rgb(255 255 255 / 0.16);
		background: rgb(255 255 255 / 0.03);
		color: #fff;
		font: inherit;
		/* 16px is the floor below which iOS zooms the page on focus. */
		font-size: 1rem;
		line-height: 1.4;
		-webkit-appearance: none;
		appearance: none;
	}

	input[type="date"] {
		min-height: 52px;
		color-scheme: dark;
	}

	textarea {
		resize: vertical;
	}

	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--color-brand, #4d9fff);
		outline-offset: 0;
		border-color: transparent;
	}

	input::placeholder,
	textarea::placeholder {
		color: rgb(255 255 255 / 0.32);
	}

	input[type="file"] {
		font-size: 0.9375rem;
		color: rgb(255 255 255 / 0.7);
	}

	input[type="file"]::file-selector-button {
		margin-right: 12px;
		padding: 9px 14px;
		border-radius: 999px;
		border: 1px solid rgb(255 255 255 / 0.2);
		background: rgb(255 255 255 / 0.08);
		color: #fff;
		font: inherit;
		font-size: 0.875rem;
	}

	.status {
		margin: -8px 0 0;
		min-height: 1.2em;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: rgb(255 255 255 / 0.55);
	}

	.status.warn {
		color: #ffb86b;
	}

	.status.ok {
		color: #8fd694;
	}

	.or {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: rgb(255 255 255 / 0.35);
	}

	.or::before,
	.or::after {
		content: "";
		flex: 1;
		height: 1px;
		background: rgb(255 255 255 / 0.1);
