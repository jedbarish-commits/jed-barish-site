	.linkish {
		padding: 0;
		border: 0;
		background: none;
		color: rgb(255 255 255 / 0.55);
		font: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
		cursor: pointer;
	}

	.seg {
		display: inline-flex;
		padding: 3px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.08);
		margin-bottom: var(--spacing-6);
	}

	.seg button {
