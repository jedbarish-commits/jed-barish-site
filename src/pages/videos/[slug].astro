---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import MobileShell from "../../layouts/MobileShell.astro";
import Reactions from "../../components/Reactions.astro";
import { titleEchoesCaption } from "../../utils/text";
import { splitVimeoRef, vimeoEmbedUrl, youtubeEmbedUrl } from "../../utils/video-links";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// The image may carry a direct src (external) or a storageKey (R2-backed).
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}

const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/videos/${slug}`,
	defaultOgImage: featuredImageUrl,
});

const bylines = post.data.bylines ?? [];
const tags = post.data.terms?.tag ?? [];

// One video per page, so the iframe is rendered up front rather than behind a
// facade — the visitor came here to watch it.
const youtubeId = post.data.youtube_id ?? null;
const vimeoRef = post.data.vimeo_id ?? null;
const vimeo = vimeoRef ? splitVimeoRef(vimeoRef) : null;

// Only web links become buttons.
const ctaUrl =
	post.data.cta_url && /^https?:\/\//i.test(post.data.cta_url) ? post.data.cta_url : null;
const transcript = post.data.transcript?.trim() || null;

// Self-hosted video (an Instagram import) is served by our range-capable
// endpoint; EmDash's media route ignores Range, which breaks seeking on
// desktop and playback entirely on iOS.
const videoFile = post.data.video_file as Record<string, unknown> | undefined;
const videoKey =
	(videoFile?.meta as Record<string, unknown> | undefined)?.storageKey ??
	videoFile?.id;
const videoSrc =
	typeof videoKey === "string" ? `/api/video/${videoKey}` : null;

const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
});
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

const publishDate =
	post.data.publishedAt?.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;
---

<MobileShell
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">
		<a href="/" class="back" aria-label="Back to feed">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M15 5l-7 7 7 7"></path>
			</svg>
			<span>Feed</span>
		</a>

		<div class="player">
			{
				videoSrc ? (
					<video
						src={videoSrc}
						controls
						playsinline
						preload="metadata"
						poster={featuredImageUrl ?? undefined}
					/>
				) : youtubeId ? (
					<iframe
						src={youtubeEmbedUrl(youtubeId)}
						title={post.data.title}
						loading="lazy"
						allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					/>
				) : vimeoRef ? (
					<iframe
						src={vimeoEmbedUrl(vimeoRef)}
						title={post.data.title}
						loading="lazy"
						allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
						allowfullscreen
					/>
				) : post.data.featured_image ? (
					<div {...post.edit.featured_image}>
						<Image image={post.data.featured_image} />
					</div>
				) : null
			}
		</div>

		<header class="head">
			<h1 {...post.edit.title}>{post.data.title}</h1>
			<div class="head-meta">
				{publishDate && <time>{publishDate}</time>}
				{
					bylines.length > 0 && (
						<>
							<span class="dot" />
							<span>
								{bylines.map((c) => c.byline.displayName).join(", ")}
							</span>
						</>
					)
				}
			</div>
			{
				post.data.excerpt &&
					!titleEchoesCaption(post.data.title, post.data.excerpt) && (
					<p class="excerpt" {...post.edit.excerpt}>
						{post.data.excerpt}
					</p>
				)
			}
			{
				ctaUrl && (
					<a class="cta" href={ctaUrl} target="_blank" rel="noopener noreferrer">
						{post.data.cta_label || "Learn more"}
						<span aria-hidden="true">↗</span>
					</a>
				)
			}
		</header>

		{
			post.data.content && (
				<div class="body">
					<PortableText value={post.data.content} />
				</div>
			)
		}

		{
			transcript && (
				<details class="transcript">
					<summary>Transcript</summary>
					<p>{transcript}</p>
				</details>
			)
		}

		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((t) => (
						<li>
							<a href={`/tag/${t.slug}`}>{t.label}</a>
						</li>
					))}
				</ul>
			)
		}

		{
			youtubeId && (
				<a
					class="yt-link"
					href={`https://www.youtube.com/watch?v=${youtubeId}`}
					target="_blank"
					rel="noopener noreferrer"
				>
					Watch on YouTube
				</a>
			)
		}
		{
			vimeo && (
				<a
					class="yt-link"
					href={`https://vimeo.com/${vimeo.id}${vimeo.hash ? `/${vimeo.hash}` : ""}`}
					target="_blank"
					rel="noopener noreferrer"
				>
					Watch on Vimeo
				</a>
			)
		}

		<Reactions collection="posts" contentId={post.data.id} />

		{
			otherPosts.length > 0 && (
				<section class="more">
					<h2>More videos</h2>
					<ul>
						{otherPosts.map((p) => (
							<li>
								<a href={`/videos/${p.id}`}>
									<span class="more-thumb">
										{p.data.featured_image && (
											<Image image={p.data.featured_image} loading="lazy" />
										)}
									</span>
									<span class="more-title">{p.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

	</article>
</MobileShell>

<style>
	.article {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-4))
			var(--spacing-5) 120px;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-bottom: var(--spacing-4);
		padding: 6px 12px 6px 8px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.07);
		color: rgb(255 255 255 / 0.7);
		text-decoration: none;
		font-size: 0.8125rem;
		-webkit-tap-highlight-color: transparent;
	}

	.back svg {
		width: 15px;
		height: 15px;
	}

	.player {
		aspect-ratio: 16 / 9;
		border-radius: 14px;
		overflow: hidden;
		background: #000;
		box-shadow: 0 8px 28px -12px rgb(0 0 0 / 0.7);
	}

	.player :global(iframe),
	.player :global(video),
	.player :global(img) {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		object-fit: cover;
	}

	.player > :global(div) {
		width: 100%;
		height: 100%;
	}

	.head {
		margin-top: var(--spacing-5);
	}

	.head h1 {
		font-size: 1.5rem;
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	.head-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-2);
		font-size: 0.75rem;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.42);
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
	}

	.excerpt {
		margin: var(--spacing-4) 0 0;
		font-size: 1rem;
		line-height: 1.55;
		color: rgb(255 255 255 / 0.72);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: var(--spacing-4);
		padding: 10px 18px;
		border-radius: 999px;
		background: #fff;
		color: #111;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}

	.transcript {
		margin-top: var(--spacing-6);
		border-top: 1px solid rgb(255 255 255 / 0.1);
		padding-top: var(--spacing-4);
	}

	.transcript summary {
		cursor: pointer;
		font-size: 0.6875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: rgb(255 255 255 / 0.42);
	}

	.transcript p {
		margin: var(--spacing-3) 0 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgb(255 255 255 / 0.78);
		/* Transcripts are typed with their own line breaks; keep them. */
		white-space: pre-wrap;
	}

	.body {
		margin-top: var(--spacing-5);
		font-size: 0.9375rem;
		line-height: 1.65;
		color: rgb(255 255 255 / 0.82);
	}

	.body :global(p) {
		margin: 0 0 var(--spacing-4);
	}

	.body :global(h2),
	.body :global(h3) {
		margin: var(--spacing-6) 0 var(--spacing-2);
		font-size: 1.0625rem;
		font-weight: 600;
		color: #fff;
	}

	.body :global(a) {
		color: #7cb8ff;
	}

	.body :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 10px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		list-style: none;
		margin: var(--spacing-5) 0 0;
		padding: 0;
	}

	.tags a {
		display: inline-block;
		padding: 5px 11px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.08);
		color: rgb(255 255 255 / 0.7);
		text-decoration: none;
		font-size: 0.75rem;
	}

	.yt-link {
		display: inline-block;
		margin-top: var(--spacing-5);
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.5);
		text-decoration: none;
		border-bottom: 1px solid rgb(255 255 255 / 0.2);
		padding-bottom: 1px;
	}

	.more {
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-5);
		border-top: 1px solid rgb(255 255 255 / 0.1);
	}

	.more h2 {
		font-size: 0.6875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: rgb(255 255 255 / 0.42);
		margin: 0 0 var(--spacing-4);
	}

	.more ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.more a {
		display: grid;
		grid-template-columns: 112px 1fr;
		gap: var(--spacing-3);
		align-items: center;
		text-decoration: none;
		color: inherit;
	}

	.more-thumb {
		display: block;
		aspect-ratio: 16 / 9;
		border-radius: 8px;
		overflow: hidden;
		background: #17171a;
	}

	.more-thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.more-title {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
	}

</style>
