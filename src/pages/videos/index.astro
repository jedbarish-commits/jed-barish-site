---
import { getEmDashCollection } from "emdash";
import MobileShell from "../../layouts/MobileShell.astro";
import VideoGrid from "../../components/VideoGrid.astro";
import ViewToggle from "../../components/ViewToggle.astro";

const PER_PAGE = 48;
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);

const { entries: all, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 1000,
});

const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const current = Math.min(page, totalPages);
const posts = all.slice((current - 1) * PER_PAGE, current * PER_PAGE);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<MobileShell title="Posts" description="Every video, newest first">
	<div class="posts-page">
		<header class="page-head">
			<div>
				<h1>Posts</h1>
				<p>
					{all.length} {all.length === 1 ? "video" : "videos"}
					{totalPages > 1 && ` · page ${current} of ${totalPages}`}
				</p>
			</div>
			{all.length > 0 && <ViewToggle />}
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Nothing published yet.</p>
			) : (
				<VideoGrid posts={posts} />
			)
		}

		{
			totalPages > 1 && (
				<nav class="pager" aria-label="Pagination">
					{current > 1 ? (
						<a href={`/videos?page=${current - 1}`} rel="prev">← Newer</a>
					) : (
						<span class="disabled">← Newer</span>
					)}
					<span class="pager-pos">{current} / {totalPages}</span>
					{current < totalPages ? (
						<a href={`/videos?page=${current + 1}`} rel="next">Older →</a>
					) : (
						<span class="disabled">Older →</span>
					)}
				</nav>
			)
		}
	</div>
</MobileShell>

<style>
	.posts-page {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	.page-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-6);
	}

	.page-head h1 {
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	.page-head p {
		margin: 4px 0 0;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.45);
	}

	.pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin-top: var(--spacing-6);
		font-size: 0.8125rem;
	}

	.pager a {
		padding: 8px 14px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.1);
		border: 1px solid rgb(255 255 255 / 0.14);
		color: #fff;
		text-decoration: none;
	}

	.pager .disabled {
		padding: 8px 14px;
		color: rgb(255 255 255 / 0.25);
	}

	.pager-pos {
		color: rgb(255 255 255 / 0.45);
		font-variant-numeric: tabular-nums;
	}

	.empty {
		color: rgb(255 255 255 / 0.5);
		font-size: 0.9375rem;
	}
</style>
