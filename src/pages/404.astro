---
import MobileShell from "../layouts/MobileShell.astro";
---

<MobileShell title="Page not found">
	<div class="not-found">
		<p class="code">404</p>
		<h1>This page doesn't exist</h1>
		<p class="hint">It may have moved, or the link is out of date.</p>
		<a href="/" class="btn">Back to the feed</a>
	</div>
</MobileShell>

<style>
	.not-found {
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: var(--spacing-2);
		padding: var(--spacing-6) var(--spacing-5) 120px;
	}

	.code {
		margin: 0;
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		color: rgb(255 255 255 / 0.16);
	}

	h1 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.hint {
		margin: 0;
		font-size: 0.9375rem;
		color: rgb(255 255 255 / 0.5);
	}

	.btn {
		margin-top: var(--spacing-4);
		padding: 11px 22px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.12);
		border: 1px solid rgb(255 255 255 / 0.16);
		color: #fff;
		text-decoration: none;
		font-size: 0.875rem;
	}
</style>
