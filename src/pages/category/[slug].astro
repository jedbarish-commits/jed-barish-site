---
import { getTerm, getEmDashCollection, decodeSlug } from "emdash";
import MobileShell from "../../layouts/MobileShell.astro";
import VideoGrid from "../../components/VideoGrid.astro";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<MobileShell
	title={term.label}
	description={`Videos in ${term.label}`}
>
	<div class="archive">
		<header>
			<p class="kicker">Category</p>
			<h1>{term.label}</h1>
			<p class="count">
				{posts.length}
				{posts.length === 1 ? "video" : "videos"}
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Nothing in {term.label} yet.</p>
			) : (
				<VideoGrid posts={posts} />
			)
		}
	</div>
</MobileShell>

<style>
	.archive {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	header {
		margin-bottom: var(--spacing-6);
	}

	.kicker {
		margin: 0 0 4px;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: rgb(255 255 255 / 0.4);
	}

	h1 {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}

	.count {
		margin: 4px 0 0;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.45);
	}

	.empty {
		color: rgb(255 255 255 / 0.5);
		font-size: 0.9375rem;
	}
</style>
