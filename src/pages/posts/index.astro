---
import { getEmDashCollection } from "emdash";
import MobileShell from "../../layouts/MobileShell.astro";
import VideoGrid from "../../components/VideoGrid.astro";
import ViewToggle from "../../components/ViewToggle.astro";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<MobileShell title="Posts" description="Every video, newest first">
	<div class="posts-page">
		<header class="page-head">
			<div>
				<h1>Posts</h1>
				<p>{posts.length} {posts.length === 1 ? "video" : "videos"}</p>
			</div>
			{posts.length > 0 && <ViewToggle />}
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Nothing published yet.</p>
			) : (
				<VideoGrid posts={posts} />
			)
		}
	</div>
</MobileShell>

<style>
	.posts-page {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	.page-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-6);
	}

	.page-head h1 {
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	.page-head p {
		margin: 4px 0 0;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.45);
	}

	.empty {
		color: rgb(255 255 255 / 0.5);
		font-size: 0.9375rem;
	}
</style>
