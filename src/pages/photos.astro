---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import MobileShell from "../layouts/MobileShell.astro";

const PER_PAGE = 48;
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);

const { entries: all, cacheHint } = await getEmDashCollection("photos", {
	orderBy: { published_at: "desc" },
	limit: 1000,
});

// Imported photos were all published today but taken over many years, so
// published_at says nothing useful about ordering. Sort on taken_at.
all.sort((a, b) => {
	const at = (e: { data: Record<string, unknown> }) => {
		const v = (e.data.taken_at ?? e.data.publishedAt) as Date | string | null;
		return v ? new Date(v).getTime() : 0;
	};
	return at(b) - at(a);
});

// Paginate after sorting: published_at ordering from the DB says nothing
// useful here, so the real order is only known once taken_at is applied.
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const current = Math.min(page, totalPages);
const photos = all.slice((current - 1) * PER_PAGE, current * PER_PAGE);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// The image may carry a direct src (a linked URL) or a storageKey (uploaded
// to R2). The lightbox needs the full-size original either way.
function fullSrc(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) return image.src;
	const meta = image.meta as Record<string, unknown> | undefined;
	const key =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	return key ? `/_emdash/api/media/file/${key}` : undefined;
}
---

<MobileShell title="Photos" description="Photographs by Jed Barish">
	<div class="photos-page">
		<header class="page-head">
			<h1>Photos</h1>
			<p>
				{all.length} {all.length === 1 ? "photo" : "photos"}
				{totalPages > 1 && ` · page ${current} of ${totalPages}`}
			</p>
		</header>

		{
			photos.length === 0 ? (
				<div class="empty">
					<p>No photos yet.</p>
					<a href="/_emdash/admin/content/photos/new" class="btn">
						Add a photo
					</a>
				</div>
			) : (
				<ul class="grid">
					{photos.map((photo) => (
						<li>
							<button
								type="button"
								class="tile"
								data-full={fullSrc(photo.data.image)}
								data-title={photo.data.title}
								data-caption={photo.data.caption ?? ""}
								data-location={photo.data.location ?? ""}
							>
								<Image image={photo.data.image} loading="lazy" />
							</button>
						</li>
					))}
				</ul>
			)
		}
		{
			totalPages > 1 && (
				<nav class="pager" aria-label="Pagination">
					{current > 1 ? (
						<a href={`/photos?page=${current - 1}`} rel="prev">
							← Newer
						</a>
					) : (
						<span class="disabled">← Newer</span>
					)}
					<span class="pager-pos">
						{current} / {totalPages}
					</span>
					{current < totalPages ? (
						<a href={`/photos?page=${current + 1}`} rel="next">
							Older →
						</a>
					) : (
						<span class="disabled">Older →</span>
					)}
				</nav>
			)
		}
	</div>

	<div class="viewer" data-viewer hidden>
		<button type="button" class="v-close" data-close aria-label="Close viewer">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>

		<div class="v-track" data-track>
			{
				photos.map((photo) => (
					<figure class="v-slide">
						<img src={fullSrc(photo.data.image)} alt={photo.data.title} loading="lazy" />
						<figcaption>
							<span class="v-title">{photo.data.title}</span>
							{photo.data.caption && <span class="v-caption">{photo.data.caption}</span>}
							{photo.data.location && <span class="v-location">{photo.data.location}</span>}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</MobileShell>

<style>
	.photos-page {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	.page-head h1 {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}

	.page-head p {
		margin: 4px 0 var(--spacing-6);
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.45);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-2);
	}

	.tile {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		padding: 0;
		border: 0;
		border-radius: 10px;
		overflow: hidden;
		background: #17171a;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.empty {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-3);
	}

	.empty p {
		margin: 0;
		color: rgb(255 255 255 / 0.5);
		font-size: 0.9375rem;
	}

	.btn {
		padding: 10px 20px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.12);
		border: 1px solid rgb(255 255 255 / 0.16);
		color: #fff;
		text-decoration: none;
		font-size: 0.875rem;
	}

	.pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin-top: var(--spacing-6);
		font-size: 0.8125rem;
	}

	.pager a {
		padding: 8px 14px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.1);
		border: 1px solid rgb(255 255 255 / 0.14);
		color: #fff;
		text-decoration: none;
	}

	.pager .disabled {
		padding: 8px 14px;
		color: rgb(255 255 255 / 0.25);
	}

	.pager-pos {
		color: rgb(255 255 255 / 0.45);
		font-variant-numeric: tabular-nums;
	}

	/* Full-screen viewer — same swipe model as the home feed. */
	.viewer {
		position: fixed;
		inset: 0;
		z-index: 80;
		background: #000;
	}

	.viewer[hidden] {
		display: none;
	}

	.v-track {
		height: 100dvh;
		overflow-y: auto;
		scroll-snap-type: y mandatory;
		overscroll-behavior-y: contain;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.v-track::-webkit-scrollbar {
		display: none;
	}

	.v-slide {
		height: 100dvh;
		margin: 0;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-4);
		padding: calc(env(safe-area-inset-top, 0px) + 56px) var(--spacing-5)
			calc(env(safe-area-inset-bottom, 0px) + var(--spacing-6));
		box-sizing: border-box;
	}

	.v-slide img {
		max-width: 100%;
		max-height: 70dvh;
		object-fit: contain;
		border-radius: 10px;
		display: block;
	}

	.v-slide figcaption {
		display: flex;
		flex-direction: column;
		gap: 4px;
		text-align: center;
		max-width: 100%;
	}

	.v-title {
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.v-caption {
		font-size: 0.875rem;
		line-height: 1.5;
		color: rgb(255 255 255 / 0.66);
		max-height: 6.5em;
		overflow-y: auto;
	}

	.v-location {
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: rgb(255 255 255 / 0.4);
	}

	.v-close {
		position: absolute;
		top: calc(env(safe-area-inset-top, 0px) + 12px);
		right: 12px;
		z-index: 1;
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.14);
		color: #fff;
		cursor: pointer;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.v-close svg {
		width: 19px;
		height: 19px;
	}

</style>

<script>
	// The viewer is a vertical snap feed of every photo, matching the home feed's
	// interaction. Opening scrolls straight to the tapped one.
	const viewer = document.querySelector<HTMLElement>("[data-viewer]");
	const track = document.querySelector<HTMLElement>("[data-track]");
	const tiles = [...document.querySelectorAll<HTMLElement>(".tile")];

	function open(index: number) {
		if (!viewer || !track) return;
		viewer.hidden = false;
		// Height is only measurable once it is displayed.
		const slide = track.children[index] as HTMLElement | undefined;
		track.scrollTop = slide ? slide.offsetTop : index * track.clientHeight;
		document.documentElement.style.overflow = "hidden";
	}

	function close() {
		if (!viewer) return;
		viewer.hidden = true;
		document.documentElement.style.overflow = "";
	}

	tiles.forEach((tile, i) => tile.addEventListener("click", () => open(i)));

	viewer?.addEventListener("click", (event) => {
		if ((event.target as HTMLElement).closest("[data-close]")) close();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && viewer && !viewer.hidden) close();
	});
</script>
