---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import MobileShell from "../../layouts/MobileShell.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<MobileShell
	title={page.data.title}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page">
		<h1 {...page.edit.title}>{page.data.title}</h1>
		<div class="content">
			<PortableText value={page.data.content} />
		</div>
	</article>
</MobileShell>

<style>
	.page {
		padding: calc(env(safe-area-inset-top, 0px) + var(--spacing-6))
			var(--spacing-5) 120px;
	}

	h1 {
		margin: 0 0 var(--spacing-5);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: var(--tracking-tight);
	}

	.content {
		font-size: 0.9375rem;
		line-height: 1.65;
		color: rgb(255 255 255 / 0.82);
	}

	.content :global(p) {
		margin: 0 0 var(--spacing-4);
	}

	.content :global(h2) {
		margin: var(--spacing-6) 0 var(--spacing-2);
		font-size: 1.125rem;
		font-weight: 600;
		color: #fff;
	}

	.content :global(h3) {
		margin: var(--spacing-5) 0 var(--spacing-2);
		font-size: 1rem;
		font-weight: 600;
		color: #fff;
	}

	.content :global(a) {
		color: #7cb8ff;
	}

	.content :global(blockquote) {
		margin: var(--spacing-4) 0;
		padding-left: var(--spacing-4);
		border-left: 2px solid rgb(255 255 255 / 0.2);
		color: rgb(255 255 255 / 0.6);
	}

	.content :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 10px;
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 var(--spacing-4);
		padding-left: var(--spacing-5);
	}

	.content :global(li) {
		margin-bottom: var(--spacing-2);
	}
</style>
